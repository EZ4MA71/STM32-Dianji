{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keil: Build",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": {
        "owner": "keil",
        "fileLocation": ["relative", "${workspaceFolder}/MDK-ARM"],
        "pattern": {
          "regexp": "^(.+)\\((\\d+)\\):\\s+(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "severity": 3, "message": 4
        }
      }
    },
    {
      "label": "Keil: Rebuild",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Rebuild"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "problemMatcher": []
    }
  ]
}
